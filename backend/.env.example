# Copie este archivo como ".env" y complete los valores. El archivo .env NO se sube a GitHub.
# Lo leen el servidor (node server.js) y docker compose.

# ----- Base de datos: OPCIÓN A · TiDB Cloud -----
# Los valores salen de TiDB Cloud → su clúster → botón "Connect" → "General" (o "Node.js").
# Host que muestra TiDB
DB_HOST=gateway01.us-west-2.prod.aws.tidbcloud.com
# TiDB usa el puerto 4000, no el 3306
DB_PORT=4000
# El usuario lleva un prefijo: copie el usuario completo, por ejemplo 2Abc3dEfGhIj.root
DB_USER=xxxxxxxxxxxx.root
DB_PASSWORD=la-clave-que-genero-TiDB
# La base de datos que creó para el taller
DB_NAME=taller_rost
# TiDB Cloud exige conexión cifrada
DB_SSL=true

# ----- Base de datos: OPCIÓN B · MySQL del docker-compose (desarrollo local) -----
# Borre las líneas de la opción A y use solo estas dos:
# DB_PASSWORD=cambie-esta-clave
# DB_NAME=taller_rost

# ----- API -----
# Cadena larga y aleatoria. Genere una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambie-esto-por-una-cadena-larga-y-aleatoria
PORT=3000
# Ponga true cuando el frontend esté en otro dominio que la API (Render + Netlify, etc.). En local, no lo defina.
# COOKIE_CROSS_SITE=true

# ----- Solo en el servidor de producción (lo escribe el despliegue automático) -----
# API_IMAGE=ghcr.io/su-usuario/su-repositorio:latest
